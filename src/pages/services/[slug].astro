---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config/site';
import { SERVICES } from '../../data/services';
import { TRUST } from '../../data/trust';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.name,
  serviceType: s.name,
  provider: { '@type': 'AutomotiveBusiness', name: SITE.brand, telephone: SITE.phone },
  areaServed: ['Fairfield CA', 'Suisun City CA', 'Vacaville CA', 'Cordelia CA', 'Dixon CA', 'Rio Vista CA'],
  availableChannel: { '@type': 'ServiceChannel', servicePhone: SITE.phone }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: SITE.url + '/#services' },
    { '@type': 'ListItem', position: 3, name: s.name, item: `${SITE.url}/services/${s.slug}/` }
  ]
};

const others = SERVICES.filter((x) => x.slug !== s.slug).slice(0, 3);
---

<Base title={s.metaTitle} description={s.metaDesc} path={`/services/${s.slug}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section>
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href="/#services">Services</a><span aria-hidden="true">/</span>
        <span aria-current="page">{s.name}</span>
      </nav>
      <p class="eyebrow">{SITE.hoursLine}</p>
      <h1>{s.h1}</h1>
      {s.intro.map((p) => <p style="max-width:42em; margin-top:1em;">{p}</p>)}
      <a class="btn-call" href={`tel:${SITE.phone}`}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
        Call {SITE.phoneDisplay}
      </a>

      <ul class="spec-list" style="margin-top:2.2rem;">
        {s.bullets.map((b) => (
          <li>
            <strong>{b.label}</strong>
            <span>{b.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Why call us</p>
      <h2>The difference on a bad night</h2>
      <div class="card-grid" style="margin-top:1.6rem;">
        {TRUST.map((t) => (
          <div class="card" style="cursor:default;">
            <h3>{t.label}</h3>
            <p>{t.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Questions we get about {s.name.toLowerCase()}</h2>
      <div style="max-width:46em; margin-top:1.4rem;">
        {s.faq.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Also available 24/7</p>
      <div class="card-grid cols3">
        {others.map((o) => (
          <a class="card" href={`/services/${o.slug}/`}>
            <span class="go" aria-hidden="true">→</span>
            <h3>{o.name}</h3>
            <p>{o.short}</p>
          </a>
        ))}
      </div>
      <p class="muted" style="margin-top:1.3rem;">
        Serving {SITE.serviceAreaLine}. See coverage for
        <a href="/areas/fairfield/">Fairfield</a>, <a href="/areas/vacaville/">Vacaville</a>,
        <a href="/areas/suisun-city/">Suisun City</a>, and <a href="/areas/cordelia/">the Cordelia Junction</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .crumb { display: flex; gap: 0.5rem; align-items: center; font-size: 0.85rem; margin-bottom: 1.2rem; }
  .crumb a { color: var(--steel); text-decoration: none; }
  .crumb a:hover { color: var(--amber); }
  .crumb span[aria-hidden] { color: var(--steel-dim); }
  .crumb span[aria-current] { color: var(--steel); }
</style>
