---
import Base from '../layouts/Base.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { SITE } from '../config/site';
import { AREAS } from '../data/cities';

const coveragePoints = AREAS.map((a) => ({ name: a.name, lat: a.mapLat, lng: a.mapLng }));
---

<Base
  title="Contact Solano Towing | 24/7 Dispatch (707) 356-7623"
  description="Reach Solano Towing dispatch 24/7 at (707) 356-7623 for towing and roadside assistance in Fairfield, Suisun City and Vacaville, CA."
  path="/contact/"
>
  <section class="s-ink">
    <div class="wrap">
      <p class="eyebrow">Fastest way: call</p>
      <h1>Dispatch is one tap away</h1>
      <p style="max-width:40em; margin-top:1em;">
        Towing is a phone business. Forms sit in inboxes; calls get trucks moving. Dispatch answers
        around the clock, every day of the year.
      </p>
      <a class="btn-call" href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</a>

      <h2 style="margin-top:3rem;">Have this ready when you call</h2>
      <ul class="spec">
        <li><strong>Where you are</strong><span>Nearest exit, cross street, or landmark. Direction of travel if you're on the freeway.</span></li>
        <li><strong>What you drive</strong><span>Year, make, model. Mention AWD, EV, or lowered so the right truck rolls first.</span></li>
        <li><strong>What happened</strong><span>Won't start, flat, accident, stuck. Thirty seconds of detail saves thirty minutes.</span></li>
        <li><strong>Where it's going</strong><span>Shop, home, or dealer. Address gets you an exact price on the spot.</span></li>
      </ul>

      <p class="muted" style="font-size:0.95rem;">
        Service area: {SITE.serviceAreaLine} · ZIPs {SITE.zips.join(', ')}
      </p>
    </div>
  </section>

  <section class="s-ink-2">
    <div class="wrap">
      <p class="eyebrow">Service area</p>
      <h2 style="margin-bottom:1.6rem;">Every town we cover</h2>
      <MapEmbed
        lat={38.2494}
        lng={-122.04}
        zoom={10}
        points={coveragePoints}
        title="Map highlighting the Solano Towing service area across Solano County, CA"
        caption={SITE.serviceAreaLine}
      />
    </div>
  </section>
</Base>
