---
// Interactive Google map via the Maps JavaScript API, themed to match the site.
// NOTE: this loads client-side JS (the Google Maps SDK) — a deliberate exception
// to the site's otherwise zero-JS build.
//
// The API key is read at build time from the environment (set as
// PUBLIC_GOOGLE_MAPS_API_KEY in Cloudflare Pages, or a local .env). Common
// alternate names are also checked so the Cloudflare variable doesn't have to be
// renamed. Requires the "Maps JavaScript API" enabled in Google Cloud.
import { SITE } from '../config/site';

interface Props {
  lat: number;
  lng: number;
  zoom?: number;
  title: string; // accessible label + marker tooltip
  caption?: string;
  // When provided, highlight every point (marker + coverage circle) and fit the
  // map to them instead of showing a single centered marker.
  points?: { name: string; lat: number; lng: number }[];
}
const { lat, lng, zoom = 12, title, caption, points } = Astro.props;

const apiKey =
  import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ||
  process.env.PUBLIC_GOOGLE_MAPS_API_KEY ||
  process.env.GOOGLE_MAPS_API_KEY ||
  process.env.MAPS_API_KEY ||
  SITE.mapsApiKey ||
  '';

if (!apiKey) {
  console.warn(
    '[MapEmbed] No Google Maps API key found. Set PUBLIC_GOOGLE_MAPS_API_KEY in the build environment.'
  );
}

const mapId = 'gmap-' + Math.random().toString(36).slice(2, 9);
const openLink = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
---

<figure class="map-embed">
  <div class="map-frame">
    {apiKey ? (
      <div id={mapId} class="map-canvas" role="img" aria-label={title}></div>
    ) : (
      <div class="map-canvas map-fallback">
        <p>Map temporarily unavailable.</p>
      </div>
    )}
  </div>
  <figcaption class="map-cap">
    {caption && <span>{caption}</span>}
    <a href={openLink} target="_blank" rel="noopener noreferrer">Open in Google Maps <span aria-hidden="true">→</span></a>
  </figcaption>
</figure>

{apiKey && (
  <script define:vars={{ apiKey, mapId, lat, lng, zoom, title, points: points || [] }}>
    (function () {
      var DARK_STYLE = [
        { elementType: 'geometry', stylers: [{ color: '#17263a' }] },
        { elementType: 'labels.text.stroke', stylers: [{ color: '#0f1722' }] },
        { elementType: 'labels.text.fill', stylers: [{ color: '#94a3b8' }] },
        { elementType: 'labels.icon', stylers: [{ visibility: 'off' }] },
        { featureType: 'administrative', elementType: 'geometry.stroke', stylers: [{ color: '#3a5068' }] },
        { featureType: 'administrative.land_parcel', stylers: [{ visibility: 'off' }] },
        { featureType: 'poi', elementType: 'geometry', stylers: [{ color: '#1b2b40' }] },
        { featureType: 'poi', elementType: 'labels', stylers: [{ visibility: 'off' }] },
        { featureType: 'poi.park', elementType: 'geometry', stylers: [{ color: '#16321f' }] },
        { featureType: 'road', elementType: 'geometry', stylers: [{ color: '#22344b' }] },
        { featureType: 'road', elementType: 'geometry.stroke', stylers: [{ color: '#0f1722' }] },
        { featureType: 'road', elementType: 'labels.text.fill', stylers: [{ color: '#8ea2b8' }] },
        { featureType: 'road.highway', elementType: 'geometry', stylers: [{ color: '#2c3f57' }] },
        { featureType: 'road.highway', elementType: 'geometry.stroke', stylers: [{ color: '#3a5068' }] },
        { featureType: 'transit', stylers: [{ visibility: 'off' }] },
        { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#0d1826' }] },
        { featureType: 'water', elementType: 'labels.text.fill', stylers: [{ color: '#4a5a72' }] }
      ];

      function initThisMap() {
        var el = document.getElementById(mapId);
        if (!el || el.dataset.ready) return;
        el.dataset.ready = '1';
        var center = { lat: lat, lng: lng };
        var map = new google.maps.Map(el, {
          center: center,
          zoom: zoom,
          styles: DARK_STYLE,
          backgroundColor: '#142031',
          mapTypeControl: false,
          streetViewControl: false,
          fullscreenControl: true,
          gestureHandling: 'cooperative'
        });

        var DOT = {
          path: google.maps.SymbolPath.CIRCLE,
          scale: 7,
          fillColor: '#e8a33d',
          fillOpacity: 1,
          strokeColor: '#201404',
          strokeWeight: 2
        };

        function highlight(pos, label) {
          new google.maps.Circle({
            map: map,
            center: pos,
            radius: 6000,
            fillColor: '#e8a33d',
            fillOpacity: 0.12,
            strokeColor: '#e8a33d',
            strokeOpacity: 0.65,
            strokeWeight: 1.5,
            clickable: false
          });
          new google.maps.Marker({ position: pos, map: map, title: label, icon: DOT });
        }

        if (points && points.length) {
          var bounds = new google.maps.LatLngBounds();
          points.forEach(function (p) {
            var pos = { lat: p.lat, lng: p.lng };
            highlight(pos, p.name);
            bounds.extend(pos);
          });
          map.fitBounds(bounds, 48);
        } else {
          highlight(center, title);
        }
      }

      // Load the Maps JS SDK once, then init every map on the page.
      if (window.google && window.google.maps) {
        initThisMap();
      } else {
        window.__gmapsQueue = window.__gmapsQueue || [];
        window.__gmapsQueue.push(initThisMap);
        if (!window.__gmapsLoading) {
          window.__gmapsLoading = true;
          window.__gmapsReady = function () {
            (window.__gmapsQueue || []).forEach(function (fn) { fn(); });
          };
          var s = document.createElement('script');
          s.src = 'https://maps.googleapis.com/maps/api/js?key=' + apiKey + '&callback=__gmapsReady';
          s.async = true;
          s.defer = true;
          document.head.appendChild(s);
        }
      }
    })();
  </script>
)}

<style>
  .map-embed { margin: 0; }
  .map-frame {
    border-radius: var(--r);
    overflow: hidden;
    border: 1px solid var(--ink-line);
    box-shadow: var(--shadow-lg);
    background: var(--ink-2);
    line-height: 0;
  }
  .map-canvas { width: 100%; height: 360px; }
  @media (min-width: 720px) { .map-canvas { height: 440px; } }
  .map-fallback {
    display: grid; place-items: center; line-height: 1.5;
    color: var(--slate); font-size: 0.95rem;
  }

  .map-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.9rem;
    font-size: 0.9rem;
    color: var(--slate);
  }
  .map-cap a {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brass);
  }
  .s-paper .map-cap { color: var(--slate-deep); }
</style>
