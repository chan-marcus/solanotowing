---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post }
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={`${post.data.title} | Solano Towing`}
  description={post.data.description}
  path={`/blog/${post.id.replace(/\.md$/, '')}/`}
  ogType="article"
>
  <section class="s-ink">
    <div class="wrap">
      <p class="eyebrow">
        {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      <article class="post">
        <h1>{post.data.title}</h1>
        {post.data.hero && (
          <figure class="post-hero">
            <img src={post.data.hero} alt={post.data.heroAlt ?? ''} width="1200" height="480" loading="eager" />
          </figure>
        )}
        <Content />
      </article>
      <a class="btn-call" href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</a>
    </div>
  </section>
</Base>

<style>
  .post { max-width: 44em; }
  .post-hero {
    margin: 1.6rem 0 0.4rem;
    border-radius: var(--r);
    overflow: hidden;
    border: 1px solid var(--ink-line);
    box-shadow: var(--shadow-lg);
    background: var(--ink-2);
  }
  .post-hero img { display: block; width: 100%; height: auto; }
  .post :global(h2) { margin-top: 1.8em; }
  .post :global(ul), .post :global(ol) { padding-left: 1.3em; margin-top: 0.8em; }
  .post :global(li) { margin-top: 0.4em; color: var(--white); }
  .post :global(li strong) { color: var(--white); }
  .post :global(p) { margin-top: 1em; color: #d6d5cf; }
</style>
