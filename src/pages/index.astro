---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';
import { SERVICES } from '../data/services';
import { AREAS } from '../data/cities';
import { TRUST, REVIEWS } from '../data/trust';

const homeFaq = [
  {
    q: 'How fast can you get to me?',
    a: `Most calls in Fairfield, Suisun City, Cordelia, and Vacaville see a truck in 20 to 30 minutes. The I-80/I-680 junction often runs faster because trucks stage nearby.`
  },
  {
    q: 'How much does a tow cost in Solano County?',
    a: 'Local tows are a hook fee plus mileage, quoted as one firm number on the phone before dispatch. No after-hours surcharge, no surprise line items at drop-off.'
  },
  {
    q: 'Are you available at 3am?',
    a: 'Yes. Dispatch answers 24/7, every day of the year. Late-night I-80 breakdowns are a large share of what we handle.'
  },
  {
    q: 'What should I do while I wait on the freeway shoulder?',
    a: 'Pull as far right as possible, hazards on, and stay in the vehicle with your seatbelt fastened unless you can exit away from traffic behind a barrier. Give dispatch your direction of travel and nearest exit.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};

const ICONS: Record<string, string> = {
  'emergency-towing':
    '<path d="M12 3 2.5 19.5h19L12 3z"/><path d="M12 10v4"/><path d="M12 17.2v.1"/>',
  'flatbed-towing':
    '<path d="M2 14h13l5-4h2v6H2z"/><circle cx="7" cy="18.5" r="1.6"/><circle cx="16" cy="18.5" r="1.6"/><path d="M4 14V9l9 3"/>',
  'jump-start': '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/>',
  'lockout-service':
    '<circle cx="8" cy="9" r="4"/><path d="M11 12l9 9"/><path d="M16 17l2-2m1 5 2-2"/>',
  'winch-out':
    '<circle cx="7" cy="7" r="3.5"/><path d="M7 10.5V14c0 2 1.5 3.5 3.5 3.5H14"/><path d="M14 15v5m0 0-2.5-2.5M14 20l2.5-2.5"/>',
  'roadside-assistance':
    '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3"/><path d="M12 3.5v5M12 15.5v5M3.5 12h5M15.5 12h5"/>',
  'motorcycle-towing':
    '<circle cx="5.5" cy="16.5" r="3"/><circle cx="18.5" cy="16.5" r="3"/><path d="M5.5 16.5 10 9h4l-2 4h6.5"/><path d="M13 6h3l1.5 3"/>',
  'heavy-duty-towing':
    '<path d="M2 16V7h11v9"/><path d="M13 10h5l4 4v2h-4"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>',
  'accident-recovery':
    '<path d="M12 21c-5-2.4-8-6-8-11V5l8-2.5L20 5v5c0 5-3 8.6-8 11z"/><path d="m9 12 2 2 4-4.5"/>',
  'long-distance-towing':
    '<path d="M4 20 20 4"/><path d="M14 4h6v6"/><path d="M4 12v8h8"/>',
  'ev-towing':
    '<rect x="4" y="9" width="13" height="8" rx="1.5"/><path d="M17 11h2l2 2v3a1 1 0 0 1-1 1"/><circle cx="8" cy="18.5" r="1.5"/><circle cx="15" cy="18.5" r="1.5"/><path d="M10 4 7.5 8h3L8 12"/>',
  'impound-retrieval':
    '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9l6 6M15 9l-6 6"/>'
};
---

<Base
  title="Solano Towing | 24/7 Towing in Fairfield, Suisun City & Vacaville, CA"
  description="24/7 towing and roadside assistance in Fairfield, Suisun City, Vacaville and the Cordelia Junction. Local trucks, ~25 minute response, up-front pricing. Call (707) 555-0134."
  path="/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Fairfield · Suisun City · Vacaville · Cordelia Junction</p>
        <h1>Broken down<br />on I-80?</h1>
        <p class="lead" style="margin-top:1.2rem;">
          A local truck is about <strong style="color:var(--white);">25 minutes out</strong>.
          24/7 dispatch for {SITE.county}: licensed local operators and one firm price
          before the truck rolls.
        </p>
        <a class="btn-call" href={`tel:${SITE.phone}`}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
          {SITE.phoneDisplay}
        </a>
        <div class="chips">
          <span class="chip"><b>~25 min</b> avg response</span>
          <span class="chip"><b>24/7</b> live dispatch</span>
          <span class="chip"><b>$0</b> after-hours surcharge</span>
        </div>
      </div>

      <div class="road-scene" aria-hidden="true">
        <svg viewBox="0 0 420 340" role="presentation">
          <defs>
            <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#141a28" />
              <stop offset="0.62" stop-color="#1a1d29" />
              <stop offset="1" stop-color="#0d0f15" />
            </linearGradient>
            <linearGradient id="glow" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffb020" stop-opacity="0.55" />
              <stop offset="1" stop-color="#ffb020" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="road" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#232733" />
              <stop offset="1" stop-color="#15171f" />
            </linearGradient>
          </defs>
          <rect width="420" height="340" rx="18" fill="url(#sky)" />
          <!-- horizon glow -->
          <ellipse cx="210" cy="176" rx="190" ry="46" fill="url(#glow)" opacity="0.5" />
          <!-- hills -->
          <path d="M0 176 Q80 148 160 170 T 420 168 V200 H0 Z" fill="#171b26" />
          <!-- wind turbines (Montezuma Hills) -->
          <g stroke="#3a4152" stroke-width="2" stroke-linecap="round">
            <path d="M96 168V138 M96 138l-11-7M96 138l12-5M96 138l-2 13" />
            <path d="M320 166V142 M320 142l-10-6M320 142l11-4M320 142l-2 11" />
          </g>
          <!-- road -->
          <path d="M150 340 L196 176 L224 176 L270 340 Z" fill="url(#road)" />
          <path d="M208 340 L209.5 176 L210.5 176 L212 340 Z" fill="none" />
          <g stroke="#ffb020" stroke-width="4" stroke-linecap="round" opacity="0.85">
            <path d="M210 196v14" stroke-width="2.4" />
            <path d="M210 226v20" stroke-width="3.2" />
            <path d="M210 264v26" />
            <path d="M210 308v32" stroke-width="5" />
          </g>
          <!-- shoulder lines -->
          <path d="M152 338 L197 178" stroke="#4a5163" stroke-width="2" />
          <path d="M268 338 L223 178" stroke="#4a5163" stroke-width="2" />
          <!-- distant headlights -->
          <circle cx="204" cy="188" r="2.4" fill="#fff3d6" opacity="0.9" />
          <circle cx="212" cy="188" r="2.4" fill="#fff3d6" opacity="0.9" />
          <!-- sign: I-80 shield hint -->
          <g transform="translate(304 208)">
            <rect x="-2" y="10" width="4" height="44" fill="#3a4152" />
            <path d="M-20 -8 h40 a6 6 0 0 1 6 6 v8 a14 14 0 0 1 -26 8 a14 14 0 0 1 -26 -8 v-8 a6 6 0 0 1 6 -6z" fill="#1f2735" stroke="#4a5163" stroke-width="2"/>
            <text x="0" y="8" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="700" font-size="17" fill="#e8e6df">80</text>
          </g>
          <!-- beacon sweep -->
          <g transform="translate(118 252)">
            <rect x="-26" y="10" width="52" height="16" rx="4" fill="#232733" stroke="#3a4152"/>
            <rect x="-20" y="-2" width="40" height="14" rx="3" fill="#1b1f2a" stroke="#3a4152"/>
            <rect x="-7" y="-9" width="14" height="7" rx="2" fill="#ffb020">
              <animate attributeName="opacity" values="1;0.25;1" dur="1.6s" repeatCount="indefinite" />
            </rect>
            <ellipse cx="0" cy="-6" rx="34" ry="12" fill="#ffb020" opacity="0.14">
              <animate attributeName="opacity" values="0.2;0.05;0.2" dur="1.6s" repeatCount="indefinite" />
            </ellipse>
          </g>
          <!-- stars -->
          <g fill="#dfe3ee" opacity="0.55">
            <circle cx="52" cy="48" r="1.2"/><circle cx="122" cy="30" r="1"/><circle cx="212" cy="56" r="1.3"/>
            <circle cx="292" cy="36" r="1"/><circle cx="362" cy="62" r="1.2"/><circle cx="330" cy="96" r="0.9"/>
            <circle cx="80" cy="92" r="0.9"/><circle cx="180" cy="104" r="0.8"/>
          </g>
        </svg>
        <p class="scene-cap">The I-80 corridor at the Cordelia Junction, our home turf.</p>
      </div>
    </div>
  </section>

  <section id="services" class="band">
    <div class="wrap">
      <p class="eyebrow">What we handle</p>
      <h2>Towing & roadside services</h2>
      <div class="card-grid cols3" style="margin-top:1.8rem;">
        {SERVICES.map((s) => (
          <a class="card" href={`/services/${s.slug}/`}>
            <span class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.slug]} />
            </span>
            <span class="go" aria-hidden="true">→</span>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="areas">
    <div class="wrap">
      <p class="eyebrow">Coverage</p>
      <h2>Built around the busiest junction in Solano County</h2>
      <p class="lead">
        Our dispatch area is drawn around where breakdowns actually happen: the I-80 corridor from
        the Vallejo line to the Vacaville grade, the I-680 approach, and Highway 12 through Suisun
        toward Rio Vista. Trucks stage near the Cordelia Junction because that interchange strands
        more drivers than anywhere else in the county.
      </p>
      <div class="card-grid cols3" style="margin-top:1.8rem;">
        <a class="card" href="/areas/fairfield/">
          <span class="go" aria-hidden="true">→</span>
          <h3>Fairfield</h3>
          <p>Our home base: I-80, the Solano Town Center area, Travis Boulevard, and North Texas Street.</p>
        </a>
        <a class="card" href="/areas/cordelia/">
          <span class="go" aria-hidden="true">→</span>
          <h3>Cordelia & Green Valley</h3>
          <p>The I-80/I-680/Hwy 12 interchange, Central Way truck stops, and Green Valley.</p>
        </a>
        {AREAS.filter((a) => a.slug !== 'cordelia' && a.slug !== 'fairfield').map((a) => (
          <a class="card" href={`/areas/${a.slug}/`}>
            <span class="go" aria-hidden="true">→</span>
            <h3>{a.name}</h3>
            <p>{a.landmarks.slice(0, 3).join(', ')} and surrounding neighborhoods.</p>
          </a>
        ))}
      </div>
      <p class="muted" style="margin-top:1.3rem; font-size:0.95rem;">
        ZIP codes served: {SITE.zips.join(', ')} · Travis AFB adjacent areas covered to the gate.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2>One call, one price, one truck</h2>
      <ol class="steps">
        <li>
          <span class="step-n">1</span>
          <div>
            <strong>Call dispatch</strong>
            <span>Tell us what happened, where you are (nearest exit or cross street), and what you drive.</span>
          </div>
        </li>
        <li>
          <span class="step-n">2</span>
          <div>
            <strong>Get a firm price and ETA</strong>
            <span>Hook fee plus mileage, quoted as one number before anything is dispatched.</span>
          </div>
        </li>
        <li>
          <span class="step-n">3</span>
          <div>
            <strong>A local operator rolls</strong>
            <span>Licensed, insured, and based in Solano County, not routed in from Sacramento or the East Bay.</span>
          </div>
        </li>
      </ol>
      <a class="btn-call" href={`tel:${SITE.phone}`}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
        Call {SITE.phoneDisplay}
      </a>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Why call us</p>
      <h2>The difference on a bad night</h2>
      <div class="card-grid" style="margin-top:1.8rem;">
        {TRUST.map((t) => (
          <div class="card" style="cursor:default;">
            <h3>{t.label}</h3>
            <p>{t.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">What drivers say</p>
      <h2>Solano County, taken care of</h2>
      <div class="card-grid cols3" style="margin-top:1.8rem;">
        {REVIEWS.map((r) => (
          <figure class="review">
            <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
            <blockquote>{r.quote}</blockquote>
            <figcaption>{r.name} · <span>{r.place}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Straight answers</p>
      <h2>Frequently asked questions</h2>
      <div style="max-width: 46em; margin-top:1.6rem;">
        {homeFaq.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(3rem, 8vw, 5rem); }
  .hero-grid { display: grid; gap: 2.6rem; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.05fr 0.95fr; } }
  .chips { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.7rem; }
  .chip {
    background: var(--panel);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.42rem 0.95rem;
    font-size: 0.92rem;
    color: var(--steel);
  }
  .chip b { color: var(--amber); font-weight: 600; }
  .road-scene svg {
    width: 100%; height: auto; display: block;
    border-radius: 18px;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .scene-cap {
    margin-top: 0.7rem; text-align: center;
    color: var(--steel-dim); font-size: 0.85rem;
  }
  .steps { list-style: none; padding: 0; display: grid; gap: 1rem; margin-top: 1.8rem; }
  @media (min-width: 860px) { .steps { grid-template-columns: 1fr 1fr 1fr; } }
  .steps li {
    display: flex; gap: 1rem; align-items: flex-start;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.3rem 1.25rem;
  }
  .step-n {
    flex: none; display: grid; place-items: center;
    width: 40px; height: 40px; border-radius: 50%;
    font-family: var(--display); font-weight: 800; font-size: 1.25rem;
    color: #161006;
    background: linear-gradient(160deg, var(--amber-hot), var(--amber));
    box-shadow: 0 6px 16px rgba(255, 176, 32, 0.3);
  }
  .steps strong {
    display: block;
    font-family: var(--display); font-weight: 700; font-size: 1.15rem;
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .steps span:not(.step-n) { color: var(--steel); font-size: 0.97rem; }
  .review {
    margin: 0;
    background: linear-gradient(170deg, var(--panel-2), var(--panel) 70%);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem 1.4rem;
  }
  .review .stars { color: var(--amber); letter-spacing: 2px; font-size: 0.95rem; margin-bottom: 0.7rem; }
  .review blockquote { margin: 0; font-size: 0.99rem; line-height: 1.6; color: var(--white); }
  .review figcaption { margin-top: 0.9rem; font-family: var(--display); text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.95rem; color: var(--white); }
  .review figcaption span { color: var(--steel); }
</style>
