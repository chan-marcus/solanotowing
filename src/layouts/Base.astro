---
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
  path?: string;
}
const { title, description, path = '/' } = Astro.props;
const canonical = new URL(path, SITE.url).href;

// The site-name label Google prints above the result. It reads this (plus
// og:site_name) from the HOMEPAGE; with neither it falls back to the bare
// domain, which is what "solanotowing.com" in the SERP was.
//
// Deliberately the plain brand, not a keyword string: Google's site-name
// guidance expects the name the site is actually known by, and treats
// promotional or stuffed values as untrustworthy, in which case it discards
// them and prints the domain again. Keywords belong in <title>, which already
// carries "24/7 Towing in Fairfield, Suisun City & Vacaville, CA".
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.brand,
  alternateName: SITE.brandAlt,
  url: SITE.url,
  publisher: { '@type': 'AutomotiveBusiness', name: SITE.brand, url: SITE.url }
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AutomotiveBusiness',
  name: SITE.brand,
  url: SITE.url,
  telephone: SITE.phone,
  description:
    '24/7 towing and roadside assistance dispatch serving Fairfield, Suisun City, Vacaville and the I-80 corridor in Solano County, CA.',
  areaServed: ['Fairfield CA', 'Suisun City CA', 'Vacaville CA', 'Cordelia CA', 'Dixon CA', 'Rio Vista CA'],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59'
  },
  priceRange: '$$'
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}/og-image.png`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f1722" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label={`${SITE.brand} home`}>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17h1.5m5.5 0h4m4.5 0H21"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M5 17V9h7l3 4h4l1 1v3"/><path d="M12 9V6l6 7"/></svg>
          </span>
          <span class="brand-name">Solano <span>Towing</span></span>
        </a>
        <nav aria-label="Main">
          <a href="/#services">Services</a>
          <a href="/#areas">Coverage</a>
          <a href="/blog/">Guides</a>
          <a href="/about/">About</a>
        </nav>
        <a class="header-call" href={`tel:${SITE.phone}`}>
          <span class="hc-status" aria-hidden="true"></span>
          <span class="hc-nums">
            <span class="hc-num">{SITE.phoneDisplay}</span>
            <span class="hc-digits">{SITE.phoneDigits}</span>
          </span>
        </a>
        <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
      <nav aria-label="Mobile">
        <a href="/#services">Services</a>
        <a href="/#areas">Coverage</a>
        <a href="/blog/">Guides</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
      </nav>
      <a class="mobile-call" href={`tel:${SITE.phone}`}>
        <span class="hc-status" aria-hidden="true"></span>
        {SITE.phoneDisplay}
      </a>
    </div>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="foot-inner">
        <div class="foot-lead">
          <p class="foot-brand">Solano <span>Towing</span></p>
          <p class="foot-tag">24/7 towing &amp; roadside dispatch for Solano County.</p>
          <a class="foot-call" href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
          <p class="foot-digits">{SITE.phoneDigits}</p>
          <p class="foot-hours"><span class="dot" aria-hidden="true"></span>{SITE.hoursLine}</p>
        </div>
        <div class="foot-cols">
          <div>
            <p class="foot-h">Coverage</p>
            <a href="/areas/fairfield/">Fairfield</a>
            <a href="/areas/suisun-city/">Suisun City</a>
            <a href="/areas/vacaville/">Vacaville</a>
            <a href="/areas/cordelia/">Cordelia</a>
            <a href="/areas/dixon/">Dixon</a>
            <a href="/areas/rio-vista/">Rio Vista</a>
          </div>
          <div>
            <p class="foot-h">Service area</p>
            <p class="foot-meta">{SITE.zips.join('  ·  ')}</p>
            <p class="foot-h" style="margin-top:1.4rem;">Corridors</p>
            <p class="foot-meta">{SITE.corridors.join('  ·  ')}</p>
          </div>
        </div>
      </div>
      <div class="foot-base">
        <p>{SITE.legalLine}</p>
        <p>© {new Date().getFullYear()} {SITE.brand} · {SITE.city}, {SITE.state}</p>
      </div>
    </footer>

    <a class="callbar" href={`tel:${SITE.phone}`} aria-label={`Call ${SITE.brand} now at ${SITE.phoneDigits}`}>
      <span class="callbar-status" aria-hidden="true"></span>
      <span class="callbar-text">
        <span class="callbar-label">24/7 Dispatch · Tap to call</span>
        <span class="callbar-num">{SITE.phoneDisplay}</span>
      </span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
    </a>

    <script>
      const btn = document.getElementById('hamburger');
      const nav = document.getElementById('mobile-nav');
      if (btn && nav) {
        btn.addEventListener('click', () => {
          const open = btn.classList.toggle('open');
          nav.classList.toggle('open', open);
          btn.setAttribute('aria-expanded', String(open));
          nav.setAttribute('aria-hidden', String(!open));
          document.body.style.overflow = open ? 'hidden' : '';
        });
        nav.querySelectorAll('a').forEach(a => {
          a.addEventListener('click', () => {
            btn.classList.remove('open');
            nav.classList.remove('open');
            btn.setAttribute('aria-expanded', 'false');
            nav.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Deep petrol-navy base, warm ivory light sections, refined brass accent */
    --ink: #0f1722;
    --ink-2: #142031;
    --ink-panel: #17263a;
    --ivory: #f6f2ea;
    --ivory-2: #efe9dd;
    --paper-line: #e2dacb;
    --brass: #e8a33d;
    --brass-deep: #c9832a;
    --brass-soft: rgba(232, 163, 61, 0.14);
    --slate: #94a3b8;
    --slate-deep: #64748b;
    --ink-line: rgba(255, 255, 255, 0.09);
    --ink-line-2: rgba(255, 255, 255, 0.16);
    --display: 'Fraunces', Georgia, serif;
    --sans: 'Archivo', system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
    --r: 16px;
    --r-sm: 10px;
    --shadow-lg: 0 30px 60px -20px rgba(5, 10, 18, 0.55);
    --shadow-sm: 0 8px 24px -12px rgba(5, 10, 18, 0.4);
  }
  * { box-sizing: border-box; margin: 0; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
  body {
    background: var(--ink);
    color: var(--ivory);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.65;
    letter-spacing: -0.005em;
    padding-bottom: 84px;
  }
  @media (min-width: 900px) { body { padding-bottom: 0; } }
  a { color: var(--brass); text-decoration: none; }
  a:focus-visible { outline: 2px solid var(--brass); outline-offset: 3px; border-radius: 3px; }

  h1, h2, h3 { font-family: var(--display); font-weight: 600; line-height: 1.05; letter-spacing: -0.01em; }
  h1 { font-size: clamp(2.1rem, 4.4vw, 3.4rem); font-weight: 600; }
  h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); }
  h3 { font-size: 1.28rem; font-weight: 600; }
  p + p { margin-top: 1em; }

  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 clamp(1.2rem, 4vw, 3rem); }
  section { padding: clamp(3.5rem, 8vw, 6.5rem) 0; }

  /* Section themes */
  .s-ink { background: var(--ink); color: var(--ivory); }
  .s-ink-2 { background: var(--ink-2); color: var(--ivory); border-block: 1px solid var(--ink-line); }
  .s-paper { background: var(--ivory); color: var(--ink); }
  .s-paper .muted { color: var(--slate-deep); }
  .s-paper h1, .s-paper h2, .s-paper h3 { color: var(--ink); }

  .eyebrow {
    font-family: var(--mono); font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.18em; font-size: 0.72rem; color: var(--brass);
    display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1.3rem;
  }
  .eyebrow::before { content: ''; width: 24px; height: 1px; background: var(--brass); }
  .muted { color: var(--slate); }
  .lead { font-size: clamp(1.1rem, 1.6vw, 1.28rem); line-height: 1.6; max-width: 34em; }

  /* Buttons */
  .btn-call {
    display: inline-flex; align-items: center; gap: 0.65rem;
    background: var(--brass); color: #201404;
    font-family: var(--sans); font-weight: 700; font-size: 1.1rem;
    letter-spacing: -0.01em; padding: 0.85rem 1.7rem; border-radius: 999px;
    margin-top: 1.7rem; box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .btn-call:hover { transform: translateY(-2px); background: #f2b04f; box-shadow: 0 14px 30px -10px rgba(232,163,61,0.5); }
  .btn-ghost {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-weight: 600; font-size: 1rem; color: inherit; margin-top: 1.7rem; margin-left: 1rem;
    border-bottom: 1px solid currentColor; padding-bottom: 2px;
  }

  /* Header */
  .site-header {
    position: sticky; top: 0; z-index: 40;
    background: rgba(15, 23, 34, 0.8); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--ink-line);
  }
  .header-inner { max-width: 1160px; margin: 0 auto; padding: 0.8rem clamp(1.2rem, 4vw, 3rem); display: flex; align-items: center; gap: 1.6rem; }
  .brand { display: flex; align-items: center; gap: 0.6rem; color: var(--ivory); }
  .brand-mark { display: grid; place-items: center; width: 38px; height: 38px; color: var(--ink); background: var(--brass); border-radius: 9px; }
  .brand-name { font-family: var(--display); font-weight: 600; font-size: 1.28rem; letter-spacing: -0.01em; }
  .brand-name span { color: var(--brass); }
  .site-header nav { display: flex; gap: 1.5rem; margin-left: auto; }
  .site-header nav a { color: var(--slate); font-weight: 500; font-size: 0.95rem; transition: color 0.15s; }
  .site-header nav a:hover { color: var(--ivory); }
  .header-call { display: flex; align-items: center; gap: 0.55rem; color: var(--ivory); padding: 0.4rem 0.9rem; border: 1px solid var(--ink-line-2); border-radius: 999px; transition: border-color 0.15s; white-space: nowrap; }
  .header-call:hover { border-color: var(--brass); }
  .hc-nums { display: flex; flex-direction: column; line-height: 1.05; }
  .hc-num { font-family: var(--mono); font-weight: 600; font-size: 1rem; white-space: nowrap; }
  .hc-digits { font-family: var(--mono); font-size: 0.66rem; color: var(--slate-deep); letter-spacing: 0.02em; }
  @media (max-width: 800px) {
    .hc-digits { display: none; }
    .hc-num { font-size: 0.88rem; }
    .header-call { padding: 0.35rem 0.7rem; }
  }
  .hc-status { width: 8px; height: 8px; border-radius: 50%; background: #56d364; box-shadow: 0 0 0 0 rgba(86,211,100,0.5); animation: pulse 2.4s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(86,211,100,0.45);} 70%{ box-shadow:0 0 0 7px rgba(86,211,100,0);} 100%{ box-shadow:0 0 0 0 rgba(86,211,100,0);} }
  @media (max-width: 800px) {
    .site-header nav { display: none; }
    .header-call { margin-left: auto; }
  }

  /* Hamburger button */
  .hamburger {
    display: none;
    flex-direction: column; justify-content: center; gap: 5px;
    width: 40px; height: 40px; padding: 8px;
    background: none; border: 1px solid var(--ink-line-2);
    border-radius: 8px; cursor: pointer; flex-shrink: 0;
  }
  .hamburger span {
    display: block; width: 100%; height: 2px;
    background: var(--ivory); border-radius: 2px;
    transition: transform 0.22s ease, opacity 0.22s ease;
  }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  @media (max-width: 800px) { .hamburger { display: flex; } }

  /* Mobile nav drawer */
  .mobile-nav {
    position: fixed; inset: 0; z-index: 39;
    background: var(--ink-2);
    display: flex; flex-direction: column;
    padding: 5.5rem 2rem 2rem;
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    border-left: 1px solid var(--ink-line);
  }
  .mobile-nav.open { transform: translateX(0); }
  .mobile-nav nav { display: flex; flex-direction: column; gap: 0.3rem; }
  .mobile-nav nav a {
    font-family: var(--display); font-weight: 600;
    font-size: clamp(1.8rem, 7vw, 2.4rem);
    color: var(--ivory); padding: 0.4rem 0;
    border-bottom: 1px solid var(--ink-line);
    transition: color 0.15s;
  }
  .mobile-nav nav a:hover { color: var(--brass); }
  .mobile-call {
    display: flex; align-items: center; gap: 0.6rem; margin-top: auto;
    font-family: var(--mono); font-weight: 600; font-size: 1.3rem;
    color: var(--brass); padding-top: 1.5rem;
    border-top: 1px solid var(--ink-line);
  }
  @media (min-width: 801px) { .mobile-nav { display: none; } }

  /* Cards */
  .grid { display: grid; gap: 1.1rem; }
  @media (min-width: 640px) { .grid.c2 { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) { .grid.c3 { grid-template-columns: repeat(3, 1fr); } .grid.c4 { grid-template-columns: repeat(4, 1fr); } }

  .card {
    position: relative; display: block; padding: 1.6rem 1.5rem;
    background: var(--ink-panel); border: 1px solid var(--ink-line);
    border-radius: var(--r); color: var(--ivory);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .card:hover { transform: translateY(-3px); border-color: rgba(232,163,61,0.4); box-shadow: var(--shadow-lg); }
  .card h3 { margin-bottom: 0.4rem; }
  .card p { color: var(--slate); font-size: 0.96rem; line-height: 1.55; }
  .s-paper .card { background: #fff; border-color: var(--paper-line); color: var(--ink); box-shadow: 0 1px 2px rgba(20,30,45,0.04); }
  .s-paper .card:hover { border-color: var(--brass); box-shadow: var(--shadow-lg); }
  .s-paper .card p { color: var(--slate-deep); }

  .card .icon { display: grid; place-items: center; width: 46px; height: 46px; margin-bottom: 1rem; border-radius: 11px; background: var(--brass-soft); color: var(--brass-deep); border: 1px solid rgba(232,163,61,0.22); }
  .card .go { position: absolute; top: 1.5rem; right: 1.4rem; color: var(--slate-deep); transition: color 0.15s, transform 0.15s; }
  .card:hover .go { color: var(--brass); transform: translate(2px,-2px); }

  /* FAQ */
  .faq-item { border-bottom: 1px solid var(--ink-line); padding: 1.3rem 0; }
  .s-paper .faq-item { border-color: var(--paper-line); }
  .faq-item h3 { font-family: var(--sans); font-weight: 700; font-size: 1.08rem; letter-spacing: -0.01em; }
  .faq-item p { color: var(--slate); margin-top: 0.4rem; }
  .s-paper .faq-item p { color: var(--slate-deep); }

  /* Spec list */
  .spec { list-style: none; padding: 0; display: grid; gap: 0.9rem; margin: 1.7rem 0; }
  @media (min-width: 720px) { .spec.two { grid-template-columns: 1fr 1fr; } }
  .spec li { padding-left: 1.1rem; border-left: 2px solid var(--brass); }
  .spec strong { font-weight: 700; font-size: 1.02rem; }
  .spec span { display: block; color: var(--slate); font-size: 0.95rem; margin-top: 0.1rem; }
  .s-paper .spec span { color: var(--slate-deep); }

  /* Footer */
  .site-footer { background: var(--ink-2); border-top: 1px solid var(--ink-line); padding: clamp(3rem,6vw,4.5rem) 0 2rem; }
  .foot-inner { max-width: 1160px; margin: 0 auto; padding: 0 clamp(1.2rem,4vw,3rem); display: grid; gap: 2.5rem; }
  @media (min-width: 820px) { .foot-inner { grid-template-columns: 1.1fr 1.4fr; } }
  .foot-brand { font-family: var(--display); font-weight: 600; font-size: 1.6rem; }
  .foot-brand span { color: var(--brass); }
  .foot-tag { color: var(--slate); margin-top: 0.3rem; max-width: 22em; }
  .foot-call { display: inline-block; font-family: var(--mono); font-weight: 600; font-size: 1.5rem; color: var(--ivory); margin-top: 1rem; }
  .foot-digits { font-family: var(--mono); font-size: 0.82rem; color: var(--slate-deep); margin-top: 0.15rem; }
  .foot-hours { display: flex; align-items: center; gap: 0.5rem; color: var(--slate); font-size: 0.9rem; margin-top: 0.5rem; }
  .foot-hours .dot { width: 7px; height: 7px; border-radius: 50%; background: #56d364; }
  .foot-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .foot-h { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--slate-deep); margin-bottom: 0.7rem; }
  .foot-cols a { display: block; color: var(--slate); font-size: 0.95rem; padding: 0.18rem 0; }
  .foot-cols a:hover { color: var(--ivory); }
  .foot-meta { font-family: var(--mono); font-size: 0.82rem; color: var(--slate); line-height: 1.8; }
  .foot-base { max-width: 1160px; margin: 2.5rem auto 0; padding: 1.5rem clamp(1.2rem,4vw,3rem) 0; border-top: 1px solid var(--ink-line); display: grid; gap: 0.5rem; }
  .foot-base p { color: var(--slate-deep); font-size: 0.8rem; line-height: 1.5; }

  /* Mobile call bar */
  .callbar { position: fixed; inset: auto 0 0 0; z-index: 50; display: flex; align-items: center; gap: 0.8rem; padding: 0.85rem 1.3rem; background: var(--brass); color: #201404; box-shadow: 0 -10px 30px -12px rgba(0,0,0,0.5); }
  .callbar-status { width: 9px; height: 9px; border-radius: 50%; background: #1c7a2b; flex: none; }
  .callbar-text { display: flex; flex-direction: column; line-height: 1.15; }
  .callbar-label { font-size: 0.72rem; font-weight: 600; opacity: 0.75; }
  .callbar-num { font-family: var(--mono); font-weight: 600; font-size: 1.35rem; }
  .callbar svg { margin-left: auto; }
  @media (min-width: 900px) { .callbar { display: none; } }
</style>
