---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post }
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const slug = post.id.replace(/\.md$/, '');

const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  mainEntityOfPage: `${SITE.url}/blog/${slug}/`,
  image: `${SITE.url}/og-image.png`,
  author: { '@type': 'Organization', name: SITE.brand, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.brand, url: SITE.url }
};

const crumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: SITE.url + '/blog/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: `${SITE.url}/blog/${slug}/` }
  ]
};
---

<Base
  title={`${post.data.title} | Solano Towing`}
  description={post.data.description}
  path={`/blog/${post.id.replace(/\.md$/, '')}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(postSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbSchema)} />
  <section class="s-ink">
    <div class="wrap">
      <p class="eyebrow">
        {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      <article class="post">
        <h1>{post.data.title}</h1>
        <Content />
      </article>
      <a class="btn-call" href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</a>
    </div>
  </section>
</Base>

<style>
  .post { max-width: 44em; }
  .post :global(h2) { margin-top: 1.8em; }
  .post :global(ul), .post :global(ol) { padding-left: 1.3em; margin-top: 0.8em; }
  .post :global(li) { margin-top: 0.4em; color: var(--white); }
  .post :global(li strong) { color: var(--white); }
  .post :global(p) { margin-top: 1em; color: #d6d5cf; }
  .post :global(img) {
    width: 100%; height: auto; display: block;
    margin: 1.8em 0; border-radius: 16px;
    border: 1px solid var(--ink-line); box-shadow: var(--shadow-sm);
  }
</style>
