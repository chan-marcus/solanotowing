---
import Base from '../layouts/Base.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { SITE } from '../config/site';
import { SERVICES } from '../data/services';
import { AREAS } from '../data/cities';
import { TRUST, REVIEWS } from '../data/trust';

const coveragePoints = AREAS.map((a) => ({ name: a.name, lat: a.mapLat, lng: a.mapLng }));

const homeFaq = [
  { q: 'How fast can you get to me?', a: 'Most calls in Fairfield, Suisun City, Cordelia, and Vacaville see a truck in 20 to 30 minutes. The I-80/I-680 junction often runs faster because trucks stage nearby.' },
  { q: 'How much does a tow cost in Solano County?', a: 'Local tows are a hook fee plus mileage, quoted as one firm number on the phone before dispatch. No after-hours surcharge, no surprise line items at drop-off.' },
  { q: 'Are you available at 3am?', a: 'Yes. Dispatch answers 24/7, every day of the year. Late-night I-80 breakdowns are a large share of what we handle.' },
  { q: 'What should I do while I wait on the freeway shoulder?', a: 'Pull as far right as possible, hazards on, and stay in the vehicle with your seatbelt fastened unless you can exit away from traffic behind a barrier. Give dispatch your direction of travel and nearest exit.' }
];

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: homeFaq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
};

const ICONS: Record<string, string> = {
  'emergency-towing': '<path d="M12 3 2.5 19.5h19L12 3z"/><path d="M12 10v4"/><path d="M12 17.2v.1"/>',
  'flatbed-towing': '<path d="M2 14h13l5-4h2v6H2z"/><circle cx="7" cy="18.5" r="1.6"/><circle cx="16" cy="18.5" r="1.6"/><path d="M4 14V9l9 3"/>',
  'jump-start': '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/>',
  'lockout-service': '<circle cx="8" cy="9" r="4"/><path d="M11 12l9 9"/><path d="M16 17l2-2m1 5 2-2"/>',
  'winch-out': '<circle cx="7" cy="7" r="3.5"/><path d="M7 10.5V14c0 2 1.5 3.5 3.5 3.5H14"/><path d="M14 15v5m0 0-2.5-2.5M14 20l2.5-2.5"/>',
  'roadside-assistance': '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3"/><path d="M12 3.5v5M12 15.5v5M3.5 12h5M15.5 12h5"/>',
  'motorcycle-towing': '<circle cx="5.5" cy="16.5" r="3"/><circle cx="18.5" cy="16.5" r="3"/><path d="M5.5 16.5 10 9h4l-2 4h6.5"/><path d="M13 6h3l1.5 3"/>',
  'heavy-duty-towing': '<path d="M2 16V7h11v9"/><path d="M13 10h5l4 4v2h-4"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>',
  'accident-recovery': '<path d="M12 21c-5-2.4-8-6-8-11V5l8-2.5L20 5v5c0 5-3 8.6-8 11z"/><path d="m9 12 2 2 4-4.5"/>',
  'long-distance-towing': '<path d="M4 20 20 4"/><path d="M14 4h6v6"/><path d="M4 12v8h8"/>',
  'ev-towing': '<rect x="4" y="9" width="13" height="8" rx="1.5"/><path d="M17 11h2l2 2v3a1 1 0 0 1-1 1"/><circle cx="8" cy="18.5" r="1.5"/><circle cx="15" cy="18.5" r="1.5"/><path d="M10 4 7.5 8h3L8 12"/>',
  'impound-retrieval': '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9l6 6M15 9l-6 6"/>'
};
---

<Base
  title="24/7 Tow Truck & Towing Service in Fairfield, CA | Solano Towing"
  description="Need a tow truck in Fairfield? 24/7 towing, roadside assistance & jump starts across Solano County. Local trucks in 20-30 min, firm price quoted up front. Call (707) 356-7623."
  path="/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <section class="s-ink hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Solano County · I-80 Corridor</p>
        <!-- nowrap keeps the hyphen in "I-80" from breaking across lines -->
        <h1>Stranded on <span style="white-space:nowrap;">I-80</span>?<br />We&rsquo;re already close.</h1>
        <p class="lead">
          24/7 tow truck service and roadside assistance across Fairfield, Suisun City,
          Vacaville, and the Cordelia Junction. Local licensed operators, a truck
          usually 20&ndash;30 minutes out, and one firm price before it rolls.
        </p>
        <div class="hero-cta">
          <a class="btn-call" href={`tel:${SITE.phone}`}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
            {SITE.phoneDisplay}
          </a>
          <a class="btn-ghost" href="/#services">See services</a>
        </div>
        <dl class="hero-stats">
          <div><dt>~25 min</dt><dd>avg response</dd></div>
          <div><dt>24/7</dt><dd>live dispatch</dd></div>
          <div><dt>Up front</dt><dd>firm quoted price</dd></div>
        </dl>
      </div>

      <figure class="hero-scene" aria-hidden="true">
        <svg viewBox="0 0 440 460" role="presentation">
          <defs>
            <linearGradient id="hsky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#16273c"/><stop offset="0.6" stop-color="#132033"/><stop offset="1" stop-color="#0d1826"/></linearGradient>
            <linearGradient id="hglow" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e8a33d" stop-opacity="0.5"/><stop offset="1" stop-color="#e8a33d" stop-opacity="0"/></linearGradient>
            <linearGradient id="hroad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#22344b"/><stop offset="1" stop-color="#101c2c"/></linearGradient>
          </defs>
          <rect width="440" height="460" rx="20" fill="url(#hsky)"/>
          <ellipse cx="220" cy="250" rx="210" ry="60" fill="url(#hglow)" opacity="0.55"/>
          <g fill="#cdd6e4" opacity="0.5">
            <circle cx="60" cy="54" r="1.2"/><circle cx="150" cy="36" r="1"/><circle cx="250" cy="60" r="1.3"/><circle cx="330" cy="40" r="1"/><circle cx="390" cy="72" r="1.2"/><circle cx="96" cy="100" r="0.9"/><circle cx="360" cy="120" r="1"/><circle cx="200" cy="110" r="0.8"/>
          </g>
          <path d="M0 250 Q90 222 180 244 T440 238 V280 H0 Z" fill="#152437"/>
          <g stroke="#3a5068" stroke-width="2" stroke-linecap="round">
            <path d="M100 244V210 M100 210l-12-8M100 210l13-6M100 210l-2 15"/>
            <path d="M338 240V212 M338 212l-11-7M338 212l12-5M338 212l-2 13"/>
          </g>
          <path d="M158 460 L206 250 L234 250 L282 460 Z" fill="url(#hroad)"/>
          <g stroke="#e8a33d" stroke-linecap="round" opacity="0.9">
            <path d="M220 272v16" stroke-width="2.6"/>
            <path d="M220 306v22" stroke-width="3.4"/>
            <path d="M220 348v30" stroke-width="4.4"/>
            <path d="M220 398v40" stroke-width="5.6"/>
          </g>
          <path d="M160 458 L207 252" stroke="#40566f" stroke-width="2"/>
          <path d="M280 458 L233 252" stroke="#40566f" stroke-width="2"/>
          <circle cx="214" cy="264" r="2.6" fill="#fff0d0"/>
          <circle cx="226" cy="264" r="2.6" fill="#fff0d0"/>
          <g transform="translate(322 286)">
            <rect x="-2" y="14" width="4" height="52" fill="#3a5068"/>
            <path d="M-22 -10 h44 a7 7 0 0 1 7 7 v9 a15 15 0 0 1 -29 9 a15 15 0 0 1 -29 -9 v-9 a7 7 0 0 1 7 -7z" fill="#1c2c40" stroke="#3a5068" stroke-width="2"/>
            <text x="0" y="10" text-anchor="middle" font-family="Archivo, sans-serif" font-weight="800" font-size="18" fill="#e6ddcb">80</text>
          </g>
          <g transform="translate(120 330)">
            <rect x="-30" y="12" width="60" height="18" rx="4" fill="#22344b" stroke="#3a5068"/>
            <rect x="-22" y="-2" width="44" height="16" rx="3" fill="#182636" stroke="#3a5068"/>
            <rect x="-8" y="-10" width="16" height="8" rx="2" fill="#e8a33d"><animate attributeName="opacity" values="1;0.3;1" dur="1.8s" repeatCount="indefinite"/></rect>
            <ellipse cx="0" cy="-6" rx="40" ry="14" fill="#e8a33d" opacity="0.16"><animate attributeName="opacity" values="0.22;0.06;0.22" dur="1.8s" repeatCount="indefinite"/></ellipse>
          </g>
        </svg>
        <figcaption class="scene-cap">Staged near the Cordelia Junction, our home turf.</figcaption>
      </figure>
    </div>
  </section>

  <!-- SERVICES (paper) -->
  <section id="services" class="s-paper">
    <div class="wrap">
      <p class="eyebrow">What we handle</p>
      <h2>Every roadside call, one number.</h2>
      <div class="grid c3" style="margin-top:2rem;">
        {SERVICES.map((s) => (
          <a class="card" href={`/services/${s.slug}/`}>
            <span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.slug]} /></span>
            <span class="go" aria-hidden="true">↗</span>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- COVERAGE (ink) -->
  <section id="areas" class="s-ink">
    <div class="wrap">
      <div class="split">
        <div>
          <p class="eyebrow">Coverage</p>
          <h2>Built around the busiest junction in the county.</h2>
        </div>
        <p class="muted split-lead">
          Our dispatch area follows where breakdowns actually happen: the I-80 corridor from
          the Vallejo line to the Vacaville grade, the I-680 approach, and Highway 12 through
          Suisun toward Rio Vista.
        </p>
      </div>
      <div style="margin-top:2.2rem;">
        <MapEmbed
          lat={38.2494}
          lng={-122.04}
          zoom={10}
          points={coveragePoints}
          title={`Map highlighting the ${SITE.brand} service area across Solano County, CA`}
          caption={SITE.serviceAreaLine}
        />
      </div>
      <div class="grid c3" style="margin-top:2.2rem;">
        <a class="card" href="/areas/fairfield/"><span class="go" aria-hidden="true">↗</span><h3>Fairfield</h3><p>I-80, Solano Town Center, Travis Boulevard, North Texas Street.</p></a>
        <a class="card" href="/areas/cordelia/"><span class="go" aria-hidden="true">↗</span><h3>Cordelia &amp; Green Valley</h3><p>The I-80/I-680/Hwy 12 interchange and Central Way truck stops.</p></a>
        {AREAS.filter((a) => a.slug !== 'cordelia' && a.slug !== 'fairfield').map((a) => (
          <a class="card" href={`/areas/${a.slug}/`}><span class="go" aria-hidden="true">↗</span><h3>{a.name}</h3><p>{a.landmarks.slice(0,3).join(', ')} and nearby.</p></a>
        ))}
      </div>
      <p class="coverage-meta">{SITE.zips.join('  ·  ')}  ·  Travis AFB adjacent areas covered to the gate.</p>
    </div>
  </section>

  <!-- HOW IT WORKS (ink-2) -->
  <section class="s-ink-2">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2>One call, one price, one truck.</h2>
      <div class="steps">
        <div class="step"><span class="step-n">01</span><h3>Call dispatch</h3><p>Tell us what happened, where you are, and what you drive.</p></div>
        <div class="step"><span class="step-n">02</span><h3>Get a firm price</h3><p>Hook fee plus mileage, quoted before anything is dispatched.</p></div>
        <div class="step"><span class="step-n">03</span><h3>A local truck rolls</h3><p>Licensed, insured, and based right here in Solano County.</p></div>
      </div>
      <a class="btn-call" href={`tel:${SITE.phone}`}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
        {SITE.phoneDisplay}
      </a>
    </div>
  </section>

  <!-- TRUST + REVIEWS (paper) -->
  <section class="s-paper">
    <div class="wrap">
      <p class="eyebrow">Why call us</p>
      <h2>The difference on a bad night.</h2>
      <div class="grid c4" style="margin-top:2rem;">
        {TRUST.map((t) => (<div class="card"><h3>{t.label}</h3><p>{t.text}</p></div>))}
      </div>

      <div class="reviews">
        {REVIEWS.map((r) => (
          <figure class="review">
            <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
            <blockquote>{r.quote}</blockquote>
            <figcaption>{r.name} <span>· {r.place}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ (ink) -->
  <section class="s-ink">
    <div class="wrap">
      <p class="eyebrow">Straight answers</p>
      <h2>Frequently asked.</h2>
      <div class="faq-wrap">
        {homeFaq.map((f) => (<div class="faq-item"><h3>{f.q}</h3><p>{f.a}</p></div>))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(3rem, 7vw, 5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 940px) { .hero-grid { grid-template-columns: 1.08fr 0.92fr; } }
  .hero h1 { margin-top: 0.2rem; }
  .hero .lead { margin-top: 1.5rem; color: var(--slate); }
  .hero-cta { display: flex; align-items: center; flex-wrap: wrap; }
  .hero-stats { display: flex; flex-wrap: wrap; gap: 1.6rem 2.4rem; margin: 2.6rem 0 0; padding-top: 1.8rem; border-top: 1px solid var(--ink-line); }
  .hero-stats div dt { font-family: var(--display); font-weight: 600; font-size: 1.9rem; color: var(--ivory); }
  .hero-stats div dd { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--slate-deep); margin-top: 0.2rem; }
  .hero-scene svg { width: 100%; height: auto; display: block; border-radius: 20px; border: 1px solid var(--ink-line); box-shadow: var(--shadow-lg); }
  .scene-cap { margin-top: 0.8rem; text-align: center; font-family: var(--mono); font-size: 0.76rem; letter-spacing: 0.03em; color: var(--slate-deep); }

  .split { display: grid; gap: 1.2rem; }
  @media (min-width: 860px) { .split { grid-template-columns: 1.3fr 1fr; align-items: end; } }
  .split-lead { font-size: 1.05rem; }
  .coverage-meta { margin-top: 1.6rem; font-family: var(--mono); font-size: 0.82rem; color: var(--slate-deep); }

  .steps { display: grid; gap: 1.1rem; margin: 2rem 0; }
  @media (min-width: 820px) { .steps { grid-template-columns: repeat(3,1fr); } }
  .step { padding: 1.7rem 1.5rem; background: var(--ink-panel); border: 1px solid var(--ink-line); border-radius: var(--r); }
  .step-n { font-family: var(--mono); font-weight: 600; font-size: 0.85rem; color: var(--brass); letter-spacing: 0.1em; }
  .step h3 { margin: 0.8rem 0 0.3rem; }
  .step p { color: var(--slate); font-size: 0.96rem; }

  .reviews { display: grid; gap: 1.1rem; margin-top: 2.4rem; }
  @media (min-width: 900px) { .reviews { grid-template-columns: repeat(3,1fr); } }
  .review { margin: 0; padding: 1.7rem 1.5rem; background: #fff; border: 1px solid var(--paper-line); border-radius: var(--r); box-shadow: var(--shadow-sm); }
  .review .stars { color: var(--brass); letter-spacing: 2px; font-size: 0.9rem; margin-bottom: 0.8rem; }
  .review blockquote { margin: 0; font-family: var(--display); font-weight: 500; font-size: 1.06rem; line-height: 1.5; color: var(--ink); }
  .review figcaption { margin-top: 1rem; font-weight: 600; font-size: 0.9rem; color: var(--ink); }
  .review figcaption span { color: var(--slate-deep); font-weight: 500; }

  .faq-wrap { max-width: 48em; margin-top: 2rem; }
</style>
