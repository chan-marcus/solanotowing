---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config/site';
import { AREAS } from '../../data/cities';
import { SERVICES } from '../../data/services';

export function getStaticPaths() {
  return AREAS.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const topServices = SERVICES.slice(0, 6);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Coverage', item: SITE.url + '/#areas' },
    { '@type': 'ListItem', position: 3, name: a.name, item: `${SITE.url}/areas/${a.slug}/` }
  ]
};

// Only emit FAQPage where the questions are actually rendered on the page:
// marking up invisible content is a structured-data violation.
const faqSchema = a.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: a.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a }
      }))
    }
  : null;
---

<Base title={a.metaTitle} description={a.metaDesc} path={`/areas/${a.slug}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <section class="s-ink">
    <div class="wrap">
      <p class="eyebrow">{SITE.hoursLine}</p>
      <h1>{a.h1}</h1>
      {a.intro.map((p) => <p style="max-width:42em; margin-top:1em;">{p}</p>)}
      <a class="btn-call" href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</a>
      <p class="muted" style="margin-top:1.2rem; font-size:0.95rem;">
        Covering {a.landmarks.join(', ')} · ZIP {a.zips.join(', ')}
      </p>
    </div>
  </section>

  {a.body && a.body.length > 0 && (
    <section class="s-paper">
      <div class="wrap">
        <div style="max-width:46em;">
          {a.body.map((sec) => (
            <div style="margin-top:2.4rem;">
              <h2 style="font-size:clamp(1.6rem,3vw,2.2rem);">{sec.h}</h2>
              {sec.p.map((para) => <p style="margin-top:0.9rem;">{para}</p>)}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {a.faq && a.faq.length > 0 && (
    <section class="s-ink-2">
      <div class="wrap">
        <p class="eyebrow">Common questions</p>
        <h2>Towing in {a.name}</h2>
        <div style="max-width:46em; margin-top:1.4rem;">
          {a.faq.map((f) => (
            <div class="faq-item"><h3>{f.q}</h3><p>{f.a}</p></div>
          ))}
        </div>
        <a class="btn-call" href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</a>
      </div>
    </section>
  )}

  <section class="s-ink">
    <div class="wrap">
      <p class="eyebrow">Available in {a.name}</p>
      <h2>Towing & roadside services</h2>
      <div class="grid c3">
        {topServices.map((s) => (
          <a class="card" href={`/services/${s.slug}/`}>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
