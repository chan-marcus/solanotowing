---
// Google Maps embed with no client-side JavaScript.
// - If SITE.mapsApiKey is set, use the official Maps Embed API.
// - Otherwise fall back to the free keyless `output=embed` endpoint.
import { SITE } from '../config/site';

interface Props {
  query: string; // place name or "lat,lng" to center the map and drop a marker
  title: string; // accessible label for the map
  zoom?: number;
  caption?: string;
}
const { query, title, zoom = 12, caption } = Astro.props;
const q = encodeURIComponent(query);
const src = SITE.mapsApiKey
  ? `https://www.google.com/maps/embed/v1/place?key=${SITE.mapsApiKey}&q=${q}&zoom=${zoom}`
  : `https://maps.google.com/maps?q=${q}&z=${zoom}&output=embed`;
const openLink = `https://www.google.com/maps/search/?api=1&query=${q}`;
---

<figure class="map-embed">
  <div class="map-frame">
    <iframe
      src={src}
      title={title}
      width="1200"
      height="440"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>
  <figcaption class="map-cap">
    {caption && <span>{caption}</span>}
    <a href={openLink} target="_blank" rel="noopener noreferrer">Open in Google Maps <span aria-hidden="true">→</span></a>
  </figcaption>
</figure>

<style>
  .map-embed { margin: 0; }
  .map-frame {
    border-radius: var(--r);
    overflow: hidden;
    border: 1px solid var(--ink-line);
    box-shadow: var(--shadow-lg);
    background: var(--ink-2);
    line-height: 0;
  }
  .map-frame iframe {
    display: block;
    width: 100%;
    height: 360px;
    border: 0;
  }
  @media (min-width: 720px) { .map-frame iframe { height: 440px; } }

  .map-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.9rem;
    font-size: 0.9rem;
    color: var(--slate);
  }
  .map-cap a {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brass);
  }
  .s-paper .map-cap { color: var(--slate-deep); }
</style>
