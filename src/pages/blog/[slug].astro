---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post }
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const slug = post.id.replace(/\.md$/, '');

const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  mainEntityOfPage: `${SITE.url}/blog/${slug}/`,
  image: `${SITE.url}/og-image.png`,
  author: { '@type': 'Organization', name: SITE.brand, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.brand, url: SITE.url }
};

const crumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: SITE.url + '/blog/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: `${SITE.url}/blog/${slug}/` }
  ]
};
---

<Base
  title={`${post.data.title} | Solano Towing`}
  description={post.data.description}
  path={`/blog/${post.id.replace(/\.md$/, '')}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(postSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbSchema)} />

  <section class="s-paper post-section">
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span>
        <a href="/blog/">Guides</a><span>/</span>
        <span aria-current="page">{post.data.title}</span>
      </nav>

      <div class="post-layout">
        <aside class="post-aside">
          <p class="aside-date">
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
          <div class="aside-dispatch">
            <p class="aside-label">Need a tow now?</p>
            <a class="aside-call" href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
            <p class="aside-digits">{SITE.phoneDigits}</p>
            <p class="aside-note">24/7 · Fairfield · Solano County</p>
          </div>
          <a href="/blog/" class="aside-back">← All guides</a>
        </aside>

        <article class="post">
          <h1>{post.data.title}</h1>
          <Content />
        </article>
      </div>

      <div class="post-cta">
        <p>Need a truck in Solano County right now?</p>
        <a class="btn-call" href={`tel:${SITE.phone}`}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
          {SITE.phoneDisplay}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .post-section { background: var(--ivory); color: var(--ink); }

  .crumb { display: flex; gap: 0.5rem; align-items: center; font-size: 0.83rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .crumb a { color: var(--slate-deep); }
  .crumb a:hover { color: var(--ink); }
  .crumb span:not([aria-current]) { color: var(--paper-line); }
  .crumb span[aria-current] { color: var(--slate-deep); }

  .post-layout { display: grid; gap: 3rem; align-items: start; }
  @media (min-width: 900px) { .post-layout { grid-template-columns: 220px 1fr; } }

  .post-aside { position: sticky; top: 5rem; }
  .aside-date { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--slate-deep); margin-bottom: 1.6rem; }
  .aside-dispatch { background: var(--ink); border-radius: 14px; padding: 1.3rem 1.1rem; margin-bottom: 1.2rem; }
  .aside-label { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--slate); margin-bottom: 0.5rem; }
  .aside-call { display: block; font-family: var(--mono); font-weight: 600; font-size: 1.15rem; color: var(--brass); }
  .aside-digits { font-family: var(--mono); font-size: 0.72rem; color: var(--slate-deep); margin-top: 0.1rem; }
  .aside-note { font-size: 0.8rem; color: var(--slate-deep); margin-top: 0.5rem; }
  .aside-back { display: inline-block; margin-top: 0.8rem; font-size: 0.9rem; font-weight: 600; color: var(--slate-deep); }
  .aside-back:hover { color: var(--ink); }
  @media (max-width: 899px) { .post-aside { position: static; } }

  .post { max-width: 100%; }
  .post :global(h1) { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 1.4rem; color: var(--ink); }
  .post :global(h2) { margin-top: 2em; margin-bottom: 0.5em; font-size: 1.6rem; color: var(--ink); }
  .post :global(p) { margin-top: 1em; color: #374151; line-height: 1.75; font-size: 1.07rem; }
  .post :global(ul), .post :global(ol) { padding-left: 1.4em; margin-top: 0.8em; }
  .post :global(li) { margin-top: 0.5em; color: #374151; font-size: 1.07rem; line-height: 1.7; }
  .post :global(li strong) { color: var(--ink); }
  .post :global(strong) { color: var(--ink); }
  .post :global(a) { color: var(--brass-deep); text-decoration: underline; text-decoration-color: rgba(201,131,42,0.35); }
  .post :global(a:hover) { text-decoration-color: var(--brass-deep); }
  .post :global(img) {
    width: 100%; height: auto; display: block;
    margin: 2em 0; border-radius: 16px;
    border: 1px solid var(--paper-line);
    box-shadow: 0 4px 20px -8px rgba(20,30,45,0.12);
  }

  .post-cta { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--paper-line); }
  .post-cta p { font-size: 1.1rem; color: var(--slate-deep); margin-bottom: 0; }
  .post-cta .btn-call { margin-top: 1rem; background: var(--ink); color: var(--brass); }
  .post-cta .btn-call:hover { background: var(--ink-2); }
</style>
